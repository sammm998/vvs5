# Backend (prefix VVS_)
VVS_DATABASE_URL=sqlite:///./data/vvs.db          # local dev; docker compose uses PostgreSQL
VVS_STORAGE_ROOT=./data/storage
VVS_SECRET_KEY=change-me
VVS_ACCESS_TOKEN_MINUTES=1440
VVS_WORKER_THREADS=1
VVS_RUN_DETERMINISM=false                          # true = run 4 extra analyses per job (order-independence proof)
VVS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VVS_ALLOW_REGISTRATION=true
VVS_SECOND_READER=false                            # true = ask a second reader about the cases the geometry
                                                   # itself declared open, among the candidates the drawing
                                                   # offers. Costs a call and a wait per open case, and turns
                                                   # the determinism check off for that job.

# Second reader (only read when VVS_SECOND_READER=true). Behind an agent proxy that attaches the credential this
# stays empty; a container that calls OpenAI itself needs the key here. Never commit a real key.
OPENAI_API_KEY=
VVS_SECOND_READER_MODEL=gpt-6-astra
