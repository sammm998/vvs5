# Backend (prefix VVS_)
VVS_DATABASE_URL=sqlite:///./data/vvs.db          # local dev; docker compose uses PostgreSQL
VVS_STORAGE_ROOT=./data/storage
VVS_SECRET_KEY=change-me
VVS_ACCESS_TOKEN_MINUTES=1440
VVS_WORKER_THREADS=1
VVS_RUN_DETERMINISM=false                          # true = run 4 extra analyses per job (order-independence proof)
VVS_CORS_ORIGINS=http://localhost:5173,http://localhost:8080
VVS_ALLOW_REGISTRATION=true
# Second reader: asks about the cases the geometry itself declared open, among the candidates the drawing offers.
# Leave VVS_SECOND_READER unset and it follows the key - on where OPENAI_API_KEY is present, off where it is not,
# because a service has exactly one use for that key. Set it to true behind a proxy that attaches the credential
# (no key of its own), or to false to keep it off whatever else is configured. It costs a call and a wait per open
# case and turns the determinism check off for that job, which the result then says. Never commit a real key.
# VVS_SECOND_READER=
OPENAI_API_KEY=
VVS_SECOND_READER_MODEL=gpt-6-astra
